format ELF64 executable 3
entry _start
segment readable executable
_start:
    call fn_main
    mov edi, eax
    mov eax, 60
    syscall

fn_main:
    push rbp
    mov rbp, rsp
    mov rax, 1
    mov rdi, 1
    lea rsi, [str_11]
    mov rdx, 15
    syscall
    mov rax, 0
    movsxd rax, eax
    mov rsp, rbp
    pop rbp
    ret

segment readable
str_11:
    db 72, 101, 108, 108, 111, 32, 83, 110, 97, 112, 83, 117, 114, 102, 10, 0
