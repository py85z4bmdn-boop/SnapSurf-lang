SourceFile
    = UseDecl* Newline* MainFn Newline* EOF ;

UseDecl
    = "use" "core" "/" "io" ;

MainFn
    = "fn" "main" "->" "i32" Newline*
      MainStmt* "end" ;

MainStmt
    = IoWrite
    | LetStmt
    | MutStmt
    | AssignStmt
    | RetStmt ;

IoWrite
    = "io" "." "write" IntLiteral StringLiteral IntLiteral ;

LetStmt
    = "let" Ident "i32" "=" Expr ;

MutStmt
    = "mut" Ident "i32" "=" Expr ;

AssignStmt
    = Ident "=" Expr ;

RetStmt
    = "ret" Expr ;

Expr
    = PrattExpression ;

Pratt precedence, low to high:

1. `+`, `-`
2. `*`, `/`, `%`
3. unary `-`
4. primary

Primary
    = IntLiteral
    | Ident
    | "true"
    | "false"
    | "(" Expr ")" ;

PackageFile
    = "package" Ident
      "version" SemVer
      "type" "executable"
      "target" "linux-x86_64"
      "runtime" "tiny"
      "entry" "main"
      RequiresLine
      DepLine*
      "end" ;

RequiresLine
    = "requires" "syscall" | "requires" "none" ;
