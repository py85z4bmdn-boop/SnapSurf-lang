SourceFile
    = (Newline | Comment)* UseDecl* MainFn (Newline | Comment)* EOF ;

UseDecl
    = "use" "core" "/" "io" Newline* ;

MainFn
    = "fn" "main" "->" "i32" Newline* Block "end" ;

Block
    = Statement* ;

Statement
    = LetDecl
    | MutDecl
    | AssignStmt
    | RetStmt
    | IoWriteStmt ;

LetDecl
    = "let" Ident "i32" "=" Expr Newline* ;

MutDecl
    = "mut" Ident "i32" "=" Expr Newline* ;

AssignStmt
    = Ident "=" Expr Newline* ;

RetStmt
    = "ret" Expr Newline* ;

IoWriteStmt
    = "io" "." "write" IntLit StrLit IntLit Newline* ;

Expr
    = PrattExpression ;

Pratt precedence, high to low:

1. unary `-`
2. `*`, `/`, `%`
3. `+`, `-`

Primary
    = IntLit
    | Ident
    | "true"
    | "false"
    | "(" Expr ")" ;

PackageFile
    = PackageField VersionField TypeField TargetField RuntimeField PackageLine* "end" ;

PackageLine
    = EntryField | RequiresField | DepField ;

PackageField
    = "package" Ident ;

VersionField
    = "version" SemVer ;

TypeField
    = "type" "executable" ;

TargetField
    = "target" "linux-x86_64" ;

RuntimeField
    = "runtime" "tiny" ;

Implemented limits:

- only one `fn main -> i32`
- only single-function `i32` locals
- mutable declarations use `mut x i32 = expr`; `let mut x ...` is rejected
- no nested scopes, if/loop/while, parameters, user functions, user types, MIR,
  borrow checking, traits, macros, or stdlib
